{
  "name": "oxlint-config-setup",
  "version": "0.0.0-development",
  "description": "An opinionated, Oxlint-first linting preset for modern TypeScript projects.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastian-software/oxlint-config-setup.git"
  },
  "bugs": {
    "url": "https://github.com/sebastian-software/oxlint-config-setup/issues"
  },
  "homepage": "https://github.com/sebastian-software/oxlint-config-setup#readme",
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.20.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./json/default": "./dist/standalone/default.json",
    "./json/react": "./dist/standalone/react.json",
    "./json/node": "./dist/standalone/node.json",
    "./json/react-node": "./dist/standalone/react-node.json",
    "./json/ai": "./dist/standalone/ai.json",
    "./json/react-ai": "./dist/standalone/react-ai.json",
    "./json/node-ai": "./dist/standalone/node-ai.json",
    "./json/react-node-ai": "./dist/standalone/react-node-ai.json",
    "./json/typescript-syntax": "./dist/standalone/typescript-syntax.json",
    "./json/vitest": "./dist/standalone/vitest.json",
    "./json/jest": "./dist/standalone/jest.json",
    "./json/react-compiler": "./dist/standalone/react-compiler.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run typecheck && tsdown && tsx scripts/generate-configs.ts",
    "benchmark": "pnpm run build && tsx scripts/benchmark.ts",
    "check": "pnpm run lint && pnpm run generate:check && pnpm run test",
    "generate": "tsx scripts/generate.ts",
    "generate:check": "tsx scripts/generate.ts --check",
    "lint": "oxlint --type-aware --deny-warnings src scripts tsdown.config.ts",
    "prepack": "pnpm run build",
    "release:check": "pnpm run check && tsx scripts/release-gate.ts",
    "test": "pnpm run test:ledger && pnpm run test:harness && pnpm run test:package",
    "test:harness": "tsx scripts/test-harness.ts",
    "test:ledger": "tsx scripts/test-ledger.ts",
    "test:package": "tsx scripts/verify-package.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsdown": "0.22.14",
    "tsx": "4.23.8",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
