{
  "categories": {
    "correctness": "off"
  },
  "options": {
    "typeAware": true
  },
  "plugins": [
    "typescript",
    "react",
    "node"
  ],
  "rules": {
    "no-console": "warn",
    "no-debugger": "error",
    "typescript/no-floating-promises": "error",
    "no-warning-comments": "warn"
  }
}
