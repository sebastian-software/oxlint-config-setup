{
  "name": "@oxlint-config-setup/spike-config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run typecheck && tsdown && tsx scripts/generate.ts",
    "generate": "tsx scripts/generate.ts",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsdown": "0.22.14",
    "tsx": "4.23.8",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001"
  }
}
