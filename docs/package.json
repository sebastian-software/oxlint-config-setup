{
  "name": "@oxlint-config-setup/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "build": "pnpm run data && ardo build",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run build && tsx scripts/check-built-site.ts",
    "data": "tsx scripts/generate-config-stats.ts",
    "dev": "pnpm run data && ardo dev",
    "lint": "oxlint --deny-warnings app scripts ardo.config.ts",
    "preview": "ardo preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ardo": "^6.6.0",
    "lucide-react": "1.31.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@fontsource/fragment-mono": "5.3.0",
    "@types/node": "24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "rollup": "4.62.4",
    "tsx": "4.23.12",
    "typescript": "7.1.0-dev.20261011.1",
    "oxc-parser": "^0.156.0"
  }
}
