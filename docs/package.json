{
  "name": "@oxlint-config-setup/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "build": "pnpm run data && react-router build",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run build && tsx scripts/check-built-site.ts",
    "data": "tsx scripts/generate-config-stats.ts",
    "dev": "pnpm run data && react-router dev",
    "lint": "oxlint --deny-warnings app scripts react-router.config.ts vite.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ardo": "4.2.0",
    "isbot": "5.2.1",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@fontsource/fragment-mono": "5.3.0",
    "@react-router/dev": "8.3.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "rollup": "4.62.4",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vite": "8.2.1"
  }
}
